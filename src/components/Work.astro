---
// Work as a retro desktop: three project folders, a PROJECT.EXE window between the hands,
// a taskbar, and a cursor label. Clicking a folder opens its project window.
// Window copy comes from mainProjects[].window in src/data/projects.js.
import bg from '../assets/work-bg.webp';
import { mainProjects, url } from '../data/projects.js';
import { icon } from '../data/icons.js';

---
<section class="work" id="work" aria-label="Work">
  <div class="stage" style={`--bg: url(${bg.src})`}>
    <ul class="folders">
      {mainProjects.map((p, i) => (
        <li style={`--x:${[125, 305, 493][i]}; --i:${i}`}>
          <button class="dir" data-open={p.slug} aria-haspopup="dialog">
            <span class="icon" aria-hidden="true">
              <svg class="back" viewBox="0 0 110 88"><path d="M4 16q0-7 7-7h27l9 9h52q7 0 7 7v54q0 7-7 7H11q-7 0-7-7z" /></svg>
              <span class="inner"></span><span class="paper p1"></span><span class="paper p2"></span><span class="paper p3"></span>
              <svg class="front" viewBox="0 0 110 88">
                <defs>
                  <linearGradient id={`face${i}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" style="stop-color: var(--f1)" /><stop offset="1" style="stop-color: var(--f2)" /></linearGradient>
                  <pattern id={`dots${i}`} width="2.4" height="2.4" patternUnits="userSpaceOnUse"><circle cx="1.2" cy="1.2" r="0.62" /></pattern>
                </defs>
                <path fill={`url(#face${i})`} d="M3 32q0-6 6-6h92q6 0 6 6l-2 48q0 7-7 7H12q-7 0-7-7z" />
                <path class="grain" fill={`url(#dots${i})`} d="M3 32q0-6 6-6h92q6 0 6 6l-2 48q0 7-7 7H12q-7 0-7-7z" />
                <path class="rim" d="M9 26.8h92" />
              </svg>
            </span>
            <span class="name">{p.short}</span>
          </button>
        </li>
      ))}
    </ul>

    <p class="corner tr">Ideas<br />Products<br />Experiments</p>
    <p class="corner bl">A collection<br />of things<br />I build</p>
    <span class="guide g1" aria-hidden="true"></span>
    <span class="guide g2" aria-hidden="true"></span>
    <span class="guide g3" aria-hidden="true"></span>
    <span class="guide g4" aria-hidden="true"></span>
    <span class="plus p-tr" aria-hidden="true">+</span>
    <span class="plus p-bl" aria-hidden="true">+</span>

    <div class="exe" aria-hidden="true">
      <div class="bar"><span>PROJECT.EXE</span><i class="min"></i><i class="max"></i><i class="x"></i></div>
    </div>

    <span class="hint-home" aria-hidden="true"></span>
    <!-- Big arrow + hint that trails the pointer; rests at .hint-home when the pointer leaves -->
    <div class="hint" aria-hidden="true">
      <svg viewBox="0 0 24 34"><path d="M1.5 1.5v27l7-6.5 4.6 10 4.3-2-4.5-9.7 9.4-.6z" /></svg>
      <span>click on a folder to explore</span>
    </div>

    <div class="taskbar" aria-hidden="true">
      <span class="start"><svg viewBox="0 0 20 20"><path d="M1 1h8v8H1zM11 1h8v8h-8zM1 11h8v8H1zM11 11h8v8h-8z" /></svg>Start</span>
      <i class="sep"></i>
      <svg class="tb" viewBox="0 0 24 24"><path d={icon.folder} /></svg>
      <svg class="tb" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="1.5" /><path d="m7 10 3 2-3 2M12 15h5" /></svg>
      <svg class="tb" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18" /></svg>
      <span class="search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6" /><path d="m20 20-4.5-4.5" /></svg>Search projects...</span>
      <span class="tray">
        <svg class="tb" viewBox="0 0 24 24"><path d="M4 9h4l5-4v14l-5-4H4zM16 9a4 4 0 0 1 0 6M18.5 6.5a8 8 0 0 1 0 11" /></svg>
        <svg class="tb" viewBox="0 0 24 24"><path d="M2 9a15 15 0 0 1 20 0M5.5 12.5a10 10 0 0 1 13 0M9 16a5 5 0 0 1 6 0" /><circle cx="12" cy="19" r="1" /></svg>
        <svg class="tb" viewBox="0 0 24 24"><rect x="2" y="7" width="18" height="10" rx="2" /><path d="M22 10v4" /><rect x="4" y="9" width="12" height="6" fill="currentColor" /></svg>
      </span>
      <i class="sep"></i>
      <span class="clock"><b></b><b></b></span>
    </div>

    {mainProjects.map((p, i) => (
      <article class="pw" id={`pw-${p.slug}`} role="dialog" aria-label={p.name} hidden>
        <header class="pw-bar">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon.folder} /></svg>
          <span>{p.short}</span>
          <em>Scroll for more · Expand ⤢</em>
          <button class="pw-btn" data-expand aria-label="Expand window"><svg viewBox="0 0 24 24"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg></button>
          <button class="pw-btn" data-close aria-label="Close window"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
        </header>
        <div class="pw-body">
          <div class="pw-top">
            <div>
              <p class="pw-num">0{i + 1}</p>
              <h3>{p.name}</h3>
              <p class="pw-lede">{p.window.lede}</p>
              <ul class="chips">{p.window.tags.map((t) => <li>{t}</li>)}</ul>
            </div>
            {p.window.hero ? <img class="ph hero-ph" src={p.window.hero} alt={p.window.lede} loading="lazy" /> : <div class="ph hero-ph" aria-label="Image placeholder"></div>}
          </div>
          <div class="pw-grid">
            <section><h4>Overview</h4><p>{p.window.overview}</p></section>
            <section><h4>My Role</h4><p>{p.window.role}</p></section>
            <section><h4>Key Highlights</h4><ul class="bullets">{p.window.highlights.map((h) => <li>{h}</li>)}</ul></section>
            <section><h4>Tools &amp; Technologies</h4><ul class="chips">{p.window.tools.map((t) => <li>{t}</li>)}</ul></section>
          </div>
          <div class="gallery">
            {p.window.gallery.map(([src, cap], n) => (
              <figure>
                {src ? <img class="ph" src={src} alt={cap} loading="lazy" /> : <div class={`ph im${n + 1}`} aria-label="Image placeholder"></div>}
                <figcaption>{cap}</figcaption>
              </figure>
            ))}
          </div>
          <div class="pw-grid">
            <section><h4>Results</h4><p>{p.window.results}</p></section>
            <section><h4>What I Learned</h4><p>{p.window.learnings}</p></section>
          </div>
          <a class="open" href={p.caseUrl ?? url(`work/${p.slug}/`)} target={p.caseUrl ? '_blank' : undefined} rel="noopener">Open full case study ↗</a>
        </div>
      </article>
    ))}
  </div>

</section>

<style>
  .work { background: #000; overflow: hidden; font-family: var(--font-mono); color: #fff; }
  /* Built from a 1672x941 reference. The art covers the stage (--a = its scale, so the
     PROJECT.EXE frame stays on it); desktop chrome is sized in --u and pinned to the edges. */
  .stage {
    --a: max(100cqw / 1672, 100cqh / 941);
    --u: clamp(0.75px, 100cqw / 1672, 1.35px);
    position: relative;
    width: 100%;
    height: min(calc(100vw * 941 / 1672), 100svh);
    min-height: 34rem;
    container-type: size;
    background: var(--bg) center / cover no-repeat;
    overflow: hidden;
    cursor: none;
  }
  .stage * { cursor: none; }

  /* Folders */
  .folders { list-style: none; margin: 0; padding: 0; }
  .folders li { position: absolute; left: calc(var(--x) * var(--u)); top: calc(22 * var(--u)); transform: translateX(-50%); z-index: 4; }
  .dir { display: grid; justify-items: center; gap: calc(12 * var(--u)); padding: 0; border: 0; background: none; color: #eee; font: inherit; }
  .icon { position: relative; width: calc(112 * var(--u)); aspect-ratio: 110 / 88; margin-top: calc(70 * var(--u)); }
  .icon svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* Folder colours animate between grey and violet */
  @property --f1 { syntax: "<color>"; inherits: true; initial-value: #8b8b91; }
  @property --f2 { syntax: "<color>"; inherits: true; initial-value: #4f4f55; }
  @property --b { syntax: "<color>"; inherits: true; initial-value: #3a3a3f; }
  .dir { transition: --f1 0.35s, --f2 0.35s, --b 0.35s; }
  .back path { fill: var(--b); }
  .grain { opacity: 0.45; fill: #000; }
  .rim { stroke: rgba(255, 255, 255, 0.35); stroke-width: 1; }
  .inner { position: absolute; left: 7%; right: 7%; top: 22%; height: 40%; border-radius: 3px; background: linear-gradient(#d9d9de, #9d9da3); }
  .paper {
    position: absolute;
    bottom: 14%;
    width: 36%;
    height: 55%;
    border-radius: 2px;
    background: repeating-linear-gradient(#f2f2f2 0 3px, #b9b9bf 3px 4px) 18% 16% / 64% 70% no-repeat, #f2f2f2;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.45);
    transition: transform 0.5s cubic-bezier(0.3, 1.45, 0.5, 1);
  }
  .p1 { left: 10%; }
  .p2 { left: 32%; transition-delay: 0.04s; }
  .p3 { left: 54%; transition-delay: 0.08s; }
  .dir:is(:hover, :focus-visible) { --f1: #9277ff; --f2: #5431e0; --b: #3d24b8; }
  .dir:is(:hover, :focus-visible) .p1 { transform: translate(-38%, -118%) rotate(-16deg); }
  .dir:is(:hover, :focus-visible) .p2 { transform: translateY(-140%) rotate(-1deg); }
  .dir:is(:hover, :focus-visible) .p3 { transform: translate(38%, -120%) rotate(15deg); }
  .dir:is(:hover, :focus-visible) .icon { filter: drop-shadow(0 0 calc(18 * var(--u)) rgba(124, 92, 255, 0.6)); }
  .name { font-size: calc(15 * var(--u)); letter-spacing: 0.04em; white-space: nowrap; }
  .dir:focus-visible .name { outline: 1px dashed #7c5cff; outline-offset: 3px; }

  /* Corner copy, guides and plus marks */
  .corner { position: absolute; margin: 0; font-size: calc(14.5 * var(--u)); line-height: 1.45; letter-spacing: 0.06em; text-transform: uppercase; color: #cfcfd4; }
  .corner::after { content: ""; display: block; width: calc(24 * var(--u)); margin-top: calc(14 * var(--u)); border-top: 1px solid #777; }
  .tr { left: calc(100% - 191 * var(--u)); top: calc(69 * var(--u)); }
  .bl { left: calc(95 * var(--u)); top: calc(100% - 233 * var(--u)); }
  .guide { position: absolute; border: 0 dashed rgba(255, 255, 255, 0.28); }
  .g1 { left: calc(100% - 32 * var(--u)); top: 0; height: calc(190 * var(--u)); border-left-width: 1px; }
  .g2 { left: calc(100% - 318 * var(--u)); right: 0; top: calc(205 * var(--u)); border-top-width: 1px; }
  .g3 { left: calc(52 * var(--u)); top: calc(100% - 254 * var(--u)); height: calc(165 * var(--u)); border-left-width: 1px; }
  .g4 { left: calc(52 * var(--u)); width: calc(234 * var(--u)); top: calc(100% - 269 * var(--u)); border-top-width: 1px; }
  .plus { position: absolute; transform: translate(-50%, -50%); font-family: var(--font-inter); font-weight: 300; font-size: calc(26 * var(--u)); line-height: 1; color: #ddd; }
  .p-tr { left: calc(100% - 32 * var(--u)); top: calc(190 * var(--u)); }
  .p-bl { left: calc(52 * var(--u)); top: calc(100% - 266 * var(--u)); }

  /* Win95-style window chrome, shared by PROJECT.EXE and the explorer pop-ups */
  .exe { position: absolute; left: calc(50% - 181 * var(--a)); top: calc(50% - 197.5 * var(--a)); width: calc(457 * var(--a)); height: calc(346 * var(--a)); border: calc(3 * var(--u)) solid #c9c9cc; box-shadow: inset 0 0 0 1px #6c6c70; }
  .bar { display: flex; align-items: center; gap: calc(3 * var(--u)); height: calc(34 * var(--u)); padding: 0 calc(5 * var(--u)) 0 calc(14 * var(--u)); background: #000; border-bottom: calc(3 * var(--u)) solid #c9c9cc; font-size: calc(15 * var(--u)); letter-spacing: 0.03em; }
  .bar span { flex: 1; }
  .bar i, .bar .x {
    position: relative;
    width: calc(21 * var(--u));
    height: calc(19 * var(--u));
    padding: 0;
    background: #c9c9cc;
    border: 1px solid;
    border-color: #fff #555 #555 #fff;
  }
  .bar .min::after { content: ""; position: absolute; left: 25%; right: 25%; bottom: 22%; border-top: 2px solid #000; }
  .bar .max::after { content: ""; position: absolute; inset: 22%; border: 1px solid #000; border-top-width: 2px; }
  .bar .x::before, .bar .x::after { content: ""; position: absolute; left: 18%; right: 18%; top: 50%; border-top: 2px solid #000; transform: rotate(45deg); }
  .bar .x::after { transform: rotate(-45deg); }

  .hint span { transition: opacity 0.2s; }
  .stage.in-win .hint span { opacity: 0; }
  .hint-home { position: absolute; left: calc(713 * var(--u)); top: calc(100% - 251 * var(--u)); }
  .hint { position: absolute; z-index: 20; left: 0; top: 0; display: flex; align-items: flex-start; gap: calc(22 * var(--u)); pointer-events: none; will-change: transform; }
  .hint svg { width: calc(30 * var(--u)); fill: #000; stroke: #fff; stroke-width: 1.6; stroke-linejoin: round; }
  .hint span { margin-top: calc(28 * var(--u)); font-size: calc(15 * var(--u)); white-space: nowrap; color: #eee; }

  /* Taskbar */
  .taskbar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(26 * var(--u));
    height: calc(60 * var(--u));
    display: flex;
    align-items: center;
    gap: calc(26 * var(--u));
    padding: 0 calc(36 * var(--u));
    background: rgba(5, 5, 8, 0.92);
    border-top: calc(2 * var(--u)) solid #b9b9be;
    border-bottom: calc(2 * var(--u)) solid #b9b9be;
    font-size: calc(15 * var(--u));
    color: #ddd;
  }
  .taskbar svg { fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .start { display: flex; align-items: center; gap: calc(12 * var(--u)); font-family: var(--font-inter); font-size: calc(19 * var(--u)); color: #fff; }
  .start svg { width: calc(26 * var(--u)); fill: #fff; stroke: none; }
  .sep { width: 1px; height: 55%; background: #777; }
  .tb { width: calc(28 * var(--u)); }
  .search {
    position: absolute;
    left: 35.5%;
    width: 24.1%;
    height: 60%;
    display: flex;
    align-items: center;
    gap: calc(12 * var(--u));
    padding-left: calc(14 * var(--u));
    border: calc(1.5 * var(--u)) solid #9a9aa0;
    border-radius: calc(6 * var(--u));
    color: #9a9aa0;
    font-size: calc(14 * var(--u));
    letter-spacing: 0.04em;
  }
  .search svg { width: calc(22 * var(--u)); color: #eee; }
  .tray { display: flex; gap: calc(20 * var(--u)); margin-left: auto; }
  .clock { display: grid; font-size: calc(14 * var(--u)); line-height: 1.4; letter-spacing: 0.06em; }
  .clock b { font-weight: 400; }

  /* Project window: opens inside the desktop, folders move to a column on the left */
  .stage.opened .folders li { left: calc(88 * var(--u)); top: calc((22 + var(--i) * 112) * var(--u)); }
  .stage.opened .icon { width: calc(84 * var(--u)); margin-top: 0; }
  .icon { transition: filter 0.35s, width 0.5s var(--ease-reveal), margin-top 0.5s var(--ease-reveal); }
  .folders li { transition: left 0.5s var(--ease-reveal), top 0.5s var(--ease-reveal); }
  .stage > :is(.exe, .corner, .guide, .plus) { transition: opacity 0.3s; }
  .stage.opened > :is(.exe, .corner, .guide, .plus) { opacity: 0; pointer-events: none; }
  .stage.opened .hint span { margin-top: calc(40 * var(--u)); padding: calc(6 * var(--u)) calc(9 * var(--u)); border: 1px solid #bbb; background: #000; white-space: normal; width: calc(150 * var(--u)); font-size: calc(13 * var(--u)); line-height: 1.2; }

  .pw {
    position: absolute;
    left: calc(200 * var(--u));
    right: calc(60 * var(--u));
    top: calc(28 * var(--u));
    bottom: calc(100 * var(--u));
    z-index: 3;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(210, 210, 230, 0.55);
    border-radius: calc(6 * var(--u));
    background: rgba(12, 12, 18, 0.9);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    box-shadow: 0 0 calc(40 * var(--u)) rgba(124, 92, 255, 0.18), 0 30px 80px rgba(0, 0, 0, 0.6);
    font-family: var(--font-inter);
    animation: pw-in 0.35s var(--ease-reveal);
  }
  .pw[hidden] { display: none; }
  @keyframes pw-in { from { opacity: 0; transform: scale(0.96); } }
  /* Expand = maximise to the whole desktop above the taskbar */
  .pw { transition: left 0.4s var(--ease-reveal), right 0.4s var(--ease-reveal), top 0.4s var(--ease-reveal), bottom 0.4s var(--ease-reveal); }
  .pw.max { left: 0; right: 0; top: 0; bottom: calc(88 * var(--u)); z-index: 6; border-radius: 0; }

  .pw-bar { display: flex; align-items: center; gap: calc(14 * var(--u)); height: calc(36 * var(--u)); padding: 0 calc(8 * var(--u)) 0 calc(24 * var(--u)); border-bottom: 1px solid rgba(210, 210, 230, 0.35); font-family: var(--font-inter); font-size: calc(16 * var(--u)); }
  .pw-bar > svg { width: calc(20 * var(--u)); fill: #eee; }
  .pw-bar span { flex: 1; }
  .pw-bar em { font-style: normal; font-family: var(--font-mono); font-size: calc(12 * var(--u)); color: #8f8fa3; letter-spacing: 0.04em; }
  .pw-btn { display: grid; place-items: center; width: calc(24 * var(--u)); height: calc(24 * var(--u)); padding: 0; border: 1px solid #bbb; background: none; color: #eee; }
  .pw-btn:hover { background: #7c5cff; border-color: #7c5cff; }
  .pw-btn svg { width: 70%; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }

  .pw-body { flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: calc(30 * var(--u)) calc(54 * var(--u)) calc(40 * var(--u)); scrollbar-width: thin; scrollbar-color: #555 transparent; }
  .pw-top { display: grid; grid-template-columns: 1fr 1.25fr; gap: calc(80 * var(--u)); padding-bottom: calc(22 * var(--u)); border-bottom: 1px solid #2c2c36; }
  .pw-num { margin: calc(20 * var(--u)) 0 calc(8 * var(--u)); font-family: var(--font-mono); font-size: calc(15 * var(--u)); color: #aaa; }
  .pw h3 { margin: 0; font-family: var(--font-mono); font-weight: 400; font-size: calc(38 * var(--u)); line-height: 1.15; letter-spacing: 0.01em; }
  .pw-lede { margin: calc(14 * var(--u)) 0 calc(22 * var(--u)); max-width: 24em; font-family: var(--font-mono); font-size: calc(17 * var(--u)); line-height: 1.6; color: #b5b5c3; }
  .chips { list-style: none; display: flex; flex-wrap: wrap; gap: calc(16 * var(--u)); margin: 0; padding: 0; }
  .chips li { padding: calc(6 * var(--u)) calc(14 * var(--u)); border: 1px solid #3a3a46; border-radius: calc(5 * var(--u)); background: #15151c; font-size: calc(15 * var(--u)); }
  .ph { position: relative; border-radius: calc(4 * var(--u)); border: 1px solid #2c2c36; overflow: hidden; }
  .ph::after { content: ""; position: absolute; left: 50%; top: 50%; width: calc(32 * var(--u)); height: calc(28 * var(--u)); transform: translate(-50%, -50%); border: 2px solid rgba(255, 255, 255, 0.4); border-radius: 3px; background: radial-gradient(circle at 70% 30%, rgba(255, 255, 255, 0.45) 2.5px, transparent 3px), linear-gradient(135deg, transparent 55%, rgba(255, 255, 255, 0.35) 55%) no-repeat; }
  /* Dusk-toned gradient stand-ins for images */
  .hero-ph { aspect-ratio: 712 / 225; background: linear-gradient(170deg, transparent 55%, #2a2534 56%), linear-gradient(200deg, transparent 50%, #3a3348 51%), linear-gradient(#584a6e, #b07a86 60%, #5b4a67); }
  .im1 { background: linear-gradient(transparent 60%, #1b1720 61%), linear-gradient(160deg, #3a2d3f, #c57b6b 55%, #4b3a4c); }
  .im2 { background: radial-gradient(ellipse at 60% 75%, #b8744a, transparent 45%), linear-gradient(#26222c, #3b3440); }
  .im3 { background: linear-gradient(transparent 55%, #24303a 56%), linear-gradient(#7a8494, #3a4552); }
  .im4 { background: linear-gradient(170deg, transparent 58%, #3a2f45 59%), linear-gradient(#4b3a5c, #7a5f82); }

  .pw-grid { display: grid; grid-template-columns: 1fr 1fr; gap: calc(26 * var(--u)) calc(130 * var(--u)); padding-top: calc(22 * var(--u)); }
  .pw h4 { margin: 0 0 calc(12 * var(--u)); font-weight: 500; font-size: calc(22 * var(--u)); }
  .pw-grid p, .bullets { margin: 0; font-size: calc(15 * var(--u)); line-height: 1.4; color: #a9a9b8; }
  .bullets { list-style: none; padding: 0; }
  .bullets li { position: relative; padding-left: calc(28 * var(--u)); margin-bottom: calc(4 * var(--u)); }
  .bullets li::before { content: ""; position: absolute; left: calc(3 * var(--u)); top: 0.45em; width: calc(10 * var(--u)); height: calc(10 * var(--u)); border-radius: 50%; background: #7c5cff; }
  .gallery { display: grid; grid-template-columns: repeat(4, 1fr); gap: calc(18 * var(--u)); margin: calc(28 * var(--u)) calc(-14 * var(--u)) calc(8 * var(--u)); }
  .gallery figure { margin: 0; }
  .gallery .ph { width: 100%; aspect-ratio: 4 / 3; }
  img.ph { display: block; width: 100%; object-fit: cover; }
  figcaption { margin-top: calc(8 * var(--u)); color: #9a9aa6; font-size: calc(12 * var(--u)); line-height: 1.4; }
  .open { display: inline-block; margin-top: calc(30 * var(--u)); padding: calc(8 * var(--u)) calc(16 * var(--u)); border: 1px solid #7c5cff; font-size: calc(15 * var(--u)); transition: background 0.2s; }
  .open:hover { background: #7c5cff; }

  /* Tablets in portrait and phones: taller desktop, folders in a row, windows full width */
  @media (max-width: 800px) {
    .stage { --u: clamp(0.8px, 100cqw / 420, 1.1px); height: min(100svh, 180vw); }
    .folders li:nth-child(1) { left: 18%; }
    .folders li:nth-child(2) { left: 50%; }
    .folders li:nth-child(3) { left: 82%; }
    .stage.opened .folders { visibility: hidden; }
    .corner, .guide, .plus, .hint, .tray, .tb, .taskbar .sep, .clock { display: none; }
    .search { left: auto; right: 4%; width: 52%; }
    .pw, .pw.max { left: 2%; right: 2%; top: calc(14 * var(--u)); bottom: calc(96 * var(--u)); }
    .pw-top, .pw-grid { grid-template-columns: 1fr; gap: 1rem; }
    .gallery { grid-template-columns: 1fr 1fr; }
    .pw-bar em { display: none; }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('.work .stage')!;
  const hint = stage.querySelector<HTMLElement>('.hint')!;

  // Hint rests at .hint-home and trails the pointer inside the stage
  const home = stage.querySelector<HTMLElement>('.hint-home')!;
  const rest = () => ({ x: home.offsetLeft, y: home.offsetTop });
  let pos = rest(), target = rest(), raf = 0;
  const tick = () => {
    pos.x += (target.x - pos.x) * 0.25;
    pos.y += (target.y - pos.y) * 0.25;
    hint.style.transform = `translate3d(${pos.x}px, ${pos.y}px, 0)`;
    raf = Math.abs(target.x - pos.x) + Math.abs(target.y - pos.y) > 0.3 ? requestAnimationFrame(tick) : 0;
  };
  const go = () => { if (!raf) raf = requestAnimationFrame(tick); };
  stage.addEventListener('pointermove', (e) => {
    const r = stage.getBoundingClientRect();
    target = { x: e.clientX - r.left - 2, y: e.clientY - r.top - 2 };
    stage.classList.toggle('in-win', !!(e.target as HTMLElement).closest('.pw'));
    go();
  });
  stage.addEventListener('pointerleave', () => { target = rest(); go(); });
  addEventListener('resize', () => { pos = target = rest(); hint.style.transform = `translate3d(${pos.x}px, ${pos.y}px, 0)`; });
  hint.style.transform = `translate3d(${pos.x}px, ${pos.y}px, 0)`;

  // Taskbar clock
  const [t, d] = stage.querySelectorAll<HTMLElement>('.clock b');
  const clock = () => {
    const now = new Date();
    t.textContent = now.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
    d.textContent = now.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).toUpperCase();
  };
  clock();
  setInterval(clock, 30000);

  // Project windows open inside the desktop; one at a time
  let open: HTMLElement | null = null;
  const close = () => {
    if (!open) return;
    open.hidden = true;
    open.classList.remove('max');
    stage.classList.remove('opened');
    open = null;
  };
  stage.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) =>
    b.addEventListener('click', () => {
      const next = document.getElementById(`pw-${b.dataset.open}`);
      if (!next || next === open) return;
      if (open) { open.hidden = true; open.classList.remove('max'); }
      open = next;
      open.hidden = false;
      open.querySelector('.pw-body')!.scrollTop = 0;
      stage.classList.add('opened');
    }),
  );
  stage.querySelectorAll<HTMLElement>('.pw').forEach((w) => {
    w.querySelector('[data-close]')!.addEventListener('click', close);
    w.querySelector('[data-expand]')!.addEventListener('click', () => w.classList.toggle('max'));
  });
  document.addEventListener('keydown', (e) => e.key === 'Escape' && close());

  // Snap: once the desktop fills 40% of the screen on the way down, settle it into full view.
  // Scrolling inside a project window never reaches the page (overscroll-behavior: contain).
  let lastY = scrollY, down = false, idle = 0, snapped = false;
  const check = () => {
    const top = stage.getBoundingClientRect().top;
    if (top > innerHeight * 0.6 || top < -stage.offsetHeight) snapped = false; // left the zone: re-arm
    if (down && !snapped && top > 2 && top <= innerHeight * 0.6) {
      snapped = true;
      scrollTo({ top: scrollY + top, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    }
  };
  addEventListener('scroll', () => {
    down = scrollY > lastY;
    lastY = scrollY;
    clearTimeout(idle);
    idle = window.setTimeout(check, 90);
  }, { passive: true });
</script>
