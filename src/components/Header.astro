---
import Logo from './Logo.astro';
import { url } from '../data/projects.js';

const links = [
  { label: 'Home', id: 'home' },
  { label: 'Work', id: 'work' },
  { label: 'Lab', id: 'lab' },
  { label: 'Contact', id: 'contact' },
];
---
<!-- Layered blur behind the bar once the page is scrolled -->
<div class="veil" aria-hidden="true">
  <div class="b1"></div><div class="b2"></div><div class="b3"></div><div class="b4"></div><div class="b5"></div>
</div>

<header class="site-header">
  <a class="brand" href={url('#home')} aria-label="Home">
    <Logo size="2.2rem" />
    <span class="tag">
      <span>Product Manager</span>
      <span class="live"><i></i>Open to PM roles</span>
    </span>
  </a>
  <nav aria-label="Main">
    <span class="pill" aria-hidden="true"></span>
    {links.map((l) => <a href={url(`#${l.id}`)} data-id={l.id}>{l.label}</a>)}
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 130;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-inline: var(--nav-inset);
    pointer-events: none; /* empty bar area must not block the page */
    transition: transform 0.45s var(--ease-reveal);
  }
  .site-header > * { pointer-events: auto; }
  :global(html.nav-hidden) .site-header { transform: translateY(-101%); }

  .brand { display: flex; align-items: center; gap: 1.1rem; color: #fff; }
  .tag {
    display: grid;
    gap: 0.1rem;
    padding-left: 1.1rem;
    border-left: 1px solid rgba(255, 255, 255, 0.18);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.5;
    color: #8a8f9c;
  }
  .live { color: var(--acc); }
  .live i { display: inline-block; width: 5px; height: 5px; margin-right: 0.55rem; border-radius: 50%; background: currentColor; vertical-align: middle; animation: blink 2s ease-in-out infinite; }

  /* Pill nav: a white pill slides under the active section */
  nav {
    position: relative;
    display: flex;
    padding: 0.3rem;
    border-radius: 999px;
    background: rgba(12, 12, 12, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    font-family: var(--font-inter);
  }
  nav a {
    position: relative;
    z-index: 1;
    padding: 0.5rem 1.15rem;
    border-radius: 999px;
    color: #a3a7b2;
    font-size: 0.9rem;
    line-height: 1.2;
    transition: color 0.3s var(--ease-swift);
  }
  nav a:hover { color: #fff; }
  nav a.on { color: #0b0b0b; }
  .pill {
    position: absolute;
    top: 0.3rem;
    bottom: 0.3rem;
    left: 0;
    width: 0;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 2px 10px rgba(255, 255, 255, 0.15);
    transition: transform 0.45s var(--ease-reveal), width 0.45s var(--ease-reveal);
  }

  .veil {
    position: fixed;
    inset: 0 0 auto;
    height: calc(var(--nav-h) * 1.3);
    z-index: 129;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(rgba(8, 8, 8, 0.55), transparent);
    transition: opacity 0.4s, transform 0.45s var(--ease-reveal);
  }
  :global(html.scrolled) .veil { opacity: 1; }
  :global(html.nav-hidden) .veil { transform: translateY(-101%); }
  .veil > div { position: absolute; inset: 0; }
  .b1 { -webkit-backdrop-filter: blur(1.125px); backdrop-filter: blur(1.125px); -webkit-mask-image: linear-gradient(to top, transparent 0, #000 20%, #000 40%, transparent 60%); mask-image: linear-gradient(to top, transparent 0, #000 20%, #000 40%, transparent 60%); }
  .b2 { -webkit-backdrop-filter: blur(2.25px); backdrop-filter: blur(2.25px); -webkit-mask-image: linear-gradient(to top, transparent 20%, #000 40%, #000 60%, transparent 80%); mask-image: linear-gradient(to top, transparent 20%, #000 40%, #000 60%, transparent 80%); }
  .b3 { -webkit-backdrop-filter: blur(4.5px); backdrop-filter: blur(4.5px); -webkit-mask-image: linear-gradient(to top, transparent 40%, #000 60%, #000 80%, transparent 100%); mask-image: linear-gradient(to top, transparent 40%, #000 60%, #000 80%, transparent 100%); }
  .b4 { -webkit-backdrop-filter: blur(9px); backdrop-filter: blur(9px); -webkit-mask-image: linear-gradient(to top, transparent 60%, #000 80%, #000 100%); mask-image: linear-gradient(to top, transparent 60%, #000 80%, #000 100%); }
  .b5 { -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); -webkit-mask-image: linear-gradient(to top, transparent 80%, #000 100%); mask-image: linear-gradient(to top, transparent 80%, #000 100%); }

  @media (max-width: 767.98px) {
    .tag { display: none; }
    nav a { padding: 0.45rem 0.75rem; font-size: 0.82rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header, .veil, .pill { transition: none; }
  }
</style>

<script>
  const root = document.documentElement;
  const nav = document.querySelector<HTMLElement>('.site-header nav')!;
  const pill = nav.querySelector<HTMLElement>('.pill')!;
  const links = [...nav.querySelectorAll<HTMLAnchorElement>('a')];
  // Only the home page has all sections; elsewhere highlight Work
  const sections = document.getElementById('home') ? (links.map((a) => document.getElementById(a.dataset.id!)).filter(Boolean) as HTMLElement[]) : [];

  const setActive = (id: string) => {
    const a = links.find((l) => l.dataset.id === id);
    if (!a) return;
    links.forEach((l) => l.classList.toggle('on', l === a));
    pill.style.width = `${a.offsetWidth}px`;
    pill.style.transform = `translateX(${a.offsetLeft}px)`;
  };

  // Active section = the last one whose top has passed 40% of the viewport
  const spy = () => {
    let id = sections[0]?.id ?? 'home';
    for (const s of sections) if (s.getBoundingClientRect().top < innerHeight * 0.4) id = s.id;
    if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) id = sections.at(-1)?.id ?? id;
    setActive(id);
  };

  // Bar hides on scroll down, returns on scroll up; blur shows once off the top.
  let lastY = scrollY;
  let ticking = false;
  const onScroll = () => {
    const y = scrollY;
    root.classList.toggle('scrolled', y > 10);
    if (y < innerHeight * 0.6 || y < lastY - 2) root.classList.remove('nav-hidden');
    else if (y > lastY + 2) root.classList.add('nav-hidden');
    lastY = y;
    if (sections.length) spy();
    ticking = false;
  };
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(onScroll); } }, { passive: true });
  addEventListener('resize', () => sections.length && spy());
  document.fonts?.ready.then(() => (sections.length ? spy() : setActive('work')));
  onScroll();
</script>
