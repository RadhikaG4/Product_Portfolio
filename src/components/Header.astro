---
import Logo from './Logo.astro';
import { url, email } from '../data/projects.js';

const links = [
  { label: 'home', href: url() },
  { label: 'work', href: url('#work') },
  { label: 'lab', href: url('#lab') },
  { label: 'contact', href: url('#contact') },
];
---
<header class="site-header">
  <a class="brand" href={url()} aria-label="Home"><Logo /></a>
  <button class="burger" aria-label="Open menu" aria-expanded="false" aria-controls="menu"><span class="lines"></span></button>
</header>

<!-- Shown when scrolling back up: layered blur behind a blend-mode bar -->
<div class="veil" aria-hidden="true">
  <div class="b1"></div><div class="b2"></div><div class="b3"></div><div class="b4"></div><div class="b5"></div>
</div>
<div class="sticky">
  <a class="brand" href={url()} aria-label="Home"><Logo /></a>
  <button class="burger" aria-label="Open menu" aria-expanded="false" aria-controls="menu"><span class="lines"></span></button>
</div>

<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Site navigation" inert>
  <div class="menu-bar">
    <a class="brand" href={url()} aria-label="Home"><Logo /></a>
    <button class="menu-close" aria-label="Close menu"><span class="lines"></span></button>
  </div>
  <nav aria-label="Main">
    <ul>{links.map((l) => <li><a href={l.href}><span>{l.label}</span></a></li>)}</ul>
  </nav>
  <a class="menu-email" href={`mailto:${email}`}>{email}</a>
</div>

<style>
  .site-header, .sticky, .menu-bar {
    position: absolute;
    inset: 0 0 auto;
    height: var(--nav-h);
    z-index: 120;
  }
  .brand {
    position: absolute;
    left: var(--nav-inset);
    top: 0;
    height: 100%;
    display: flex;
    align-items: center;
    color: #fff;
    transition: opacity 0.2s var(--ease-swift);
  }
  .brand:hover { opacity: 0.75; }

  /* Burger: two lines that wipe out and back in on hover */
  .burger, .menu-close {
    position: absolute;
    right: var(--nav-inset);
    top: 0;
    height: 100%;
    display: flex;
    align-items: center;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .lines { position: relative; display: block; width: 24px; height: 10px; overflow: clip; }
  .lines::before, .lines::after {
    content: "";
    position: absolute;
    inset: 4px 0 auto;
    height: 2px;
    border-radius: 1px;
    background: #fff;
  }
  .lines::before { transform: translateY(-4px); }
  .lines::after { transform: translateY(4px); }
  .burger.wipe .lines::before { animation: wipe-top 0.55s cubic-bezier(0.65, 0, 0.35, 1) both; }
  .burger.wipe .lines::after { animation: wipe-bottom 0.55s cubic-bezier(0.65, 0, 0.35, 1) 0.07s both; }
  @keyframes wipe-top {
    0% { transform: translateY(-4px) scaleX(1); transform-origin: 100% 50%; }
    46% { transform: translateY(-4px) scaleX(0); transform-origin: 100% 50%; }
    54% { transform: translateY(-4px) scaleX(0); transform-origin: 0 50%; }
    100% { transform: translateY(-4px) scaleX(1); transform-origin: 0 50%; }
  }
  @keyframes wipe-bottom {
    0% { transform: translateY(4px) scaleX(1); transform-origin: 0 50%; }
    46% { transform: translateY(4px) scaleX(0); transform-origin: 0 50%; }
    54% { transform: translateY(4px) scaleX(0); transform-origin: 100% 50%; }
    100% { transform: translateY(4px) scaleX(1); transform-origin: 100% 50%; }
  }

  /* Sticky bar + graduated blur, revealed on scroll-up */
  .veil, .sticky {
    position: fixed;
    transform: translateY(-101%);
    transition: transform 0.45s var(--ease-reveal);
  }
  :global(html.scrolled) :is(.veil, .sticky) { transform: none; }
  :global(html.menu-open) :is(.veil, .sticky) { transform: translateY(-101%); }
  .sticky { z-index: 130; mix-blend-mode: difference; }
  .veil { inset: 0 0 auto; height: calc(var(--nav-h) * 1.3); z-index: 129; pointer-events: none; }
  .veil > div { position: absolute; inset: 0; }
  .b1 { backdrop-filter: blur(1.125px); mask-image: linear-gradient(to top, transparent 0, #000 20%, #000 40%, transparent 60%); }
  .b2 { backdrop-filter: blur(2.25px); mask-image: linear-gradient(to top, transparent 20%, #000 40%, #000 60%, transparent 80%); }
  .b3 { backdrop-filter: blur(4.5px); mask-image: linear-gradient(to top, transparent 40%, #000 60%, #000 80%, transparent 100%); }
  .b4 { backdrop-filter: blur(9px); mask-image: linear-gradient(to top, transparent 60%, #000 80%, #000 100%); }
  .b5 { backdrop-filter: blur(18px); mask-image: linear-gradient(to top, transparent 80%, #000 100%); }

  /* Full-screen menu: inverted frosted glass that wipes down */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 200;
    visibility: hidden;
    background: #00000029;
    backdrop-filter: invert(1) blur(50px) contrast(0.82);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.62s var(--ease-reveal), visibility 0s linear 0.62s;
  }
  :global(html.menu-open) .menu {
    visibility: visible;
    clip-path: inset(0);
    transition: clip-path 0.62s var(--ease-reveal), visibility 0s;
  }
  :global(html.menu-open) { overflow: hidden; }
  .menu-bar { z-index: 4; }
  .menu-close .lines { overflow: visible; }
  .menu-close .lines::before, .menu-close .lines::after { transition: transform 0.34s var(--ease-reveal) 0.16s; }
  :global(html.menu-open) .menu-close .lines::before { transform: rotate(45deg); }
  :global(html.menu-open) .menu-close .lines::after { transform: rotate(-45deg); }

  .menu nav { position: absolute; inset: 0; display: grid; place-items: center; z-index: 2; pointer-events: none; }
  .menu ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
  .menu li { opacity: 0; transform: translateY(1.1rem); transition: opacity 0.5s var(--ease-reveal), transform 0.5s var(--ease-reveal); }
  :global(html.menu-open) .menu li { opacity: 1; transform: none; }
  :global(html.menu-open) .menu li:nth-child(1) { transition-delay: 0.3s; }
  :global(html.menu-open) .menu li:nth-child(2) { transition-delay: 0.38s; }
  :global(html.menu-open) .menu li:nth-child(3) { transition-delay: 0.46s; }
  :global(html.menu-open) .menu li:nth-child(4) { transition-delay: 0.54s; }
  .menu nav a {
    display: inline-block;
    pointer-events: auto;
    font-weight: 700;
    font-size: clamp(2.8rem, 8vw, 5.33333rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    transition: filter 0.75s cubic-bezier(0.33, 1, 0.68, 1);
  }
  .menu nav a span {
    -webkit-text-fill-color: #fff;
    background: linear-gradient(90deg, #fff, #d4d4d4, #fff) 0 0 / 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    animation: sheen 2.2s linear infinite paused;
    transition: -webkit-text-fill-color 0.45s var(--ease-swift);
  }
  /* Hovering one link blurs the rest, neighbours less */
  .menu ul:hover a { filter: blur(6px); }
  .menu ul:hover li:hover + li a, .menu ul:hover li:has(+ li:hover) a { filter: blur(3px); }
  .menu ul:hover li:hover a { filter: none; transition-duration: 0.3s; }
  .menu ul:hover li:hover a span { -webkit-text-fill-color: transparent; animation-play-state: running; }
  @keyframes sheen { to { background-position: 200% 0; } }

  .menu-email {
    position: absolute;
    inset: auto 0 2.66667rem;
    z-index: 2;
    text-align: center;
    font-size: 1.11111rem;
    text-decoration: underline;
    text-underline-offset: 0.14em;
    opacity: 0;
    transition: opacity 0.5s var(--ease-reveal) 0.55s, color 0.2s var(--ease-swift);
  }
  :global(html.menu-open) .menu-email { opacity: 1; }
  .menu-email:hover { color: #bdbdbd; }
</style>

<script>
  const root = document.documentElement;
  const menu = document.getElementById('menu')!;
  const burgers = document.querySelectorAll<HTMLButtonElement>('.burger');

  const setMenu = (open: boolean) => {
    root.classList.toggle('menu-open', open);
    menu.toggleAttribute('inert', !open);
    burgers.forEach((b) => b.setAttribute('aria-expanded', String(open)));
    if (open) menu.querySelector<HTMLElement>('.menu-close')?.focus();
  };
  burgers.forEach((b) => b.addEventListener('click', () => setMenu(true)));
  menu.querySelector('.menu-close')!.addEventListener('click', () => setMenu(false));
  menu.querySelectorAll('nav a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setMenu(false));

  if (matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
    burgers.forEach((b) => {
      b.addEventListener('mouseenter', () => b.classList.add('wipe'));
      b.addEventListener('animationend', (e) => e.pseudoElement === '::after' && b.classList.remove('wipe'));
    });
  }

  // Sticky bar appears when scrolling up past 60% of the viewport, hides on scroll down.
  let lastY = scrollY;
  let ticking = false;
  const onScroll = () => {
    const y = scrollY;
    if (y <= innerHeight * 0.6) root.classList.remove('scrolled');
    else if (y < lastY - 2) root.classList.add('scrolled');
    else if (y > lastY + 2) root.classList.remove('scrolled');
    lastY = y;
    ticking = false;
  };
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(onScroll); } }, { passive: true });
</script>
