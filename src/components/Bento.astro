---
// Headline achievements. Every number comes from content/facts.md (resume).
const ticks = Array.from({ length: 26 }, (_, i) => -120 + (240 / 25) * i);
const bars = [18, 26, 22, 34, 30, 44, 40, 52, 48, 62, 58, 72, 68, 84];
---
<section class="bento" aria-label="Highlights">
  <div class="grid container">
    <article class="tile gauge">
      <p class="cap">Stores onboarded</p>
      <svg viewBox="0 0 200 118" aria-hidden="true">
        {ticks.map((a, i) => (
          <line x1="100" y1="16" x2="100" y2={i % 5 === 0 ? 34 : 30} transform={`rotate(${a} 100 104)`} class={i < 19 ? 'lit' : ''} style={`--i:${i}`} />
        ))}
        <line class="needle" x1="100" y1="104" x2="100" y2="44" />
        <circle cx="100" cy="104" r="4" class="hub" />
      </svg>
      <p class="sub">in the first 2 months</p>
      <p class="big" data-count="600" data-pre="~">~600</p>
      <ul class="chips"><li>Tata Consumer</li><li>MVP pilot</li><li>Mumbai</li></ul>
    </article>

    <article class="tile a">
      <p class="cap">Portfolios monitored</p>
      <p class="big" data-count="5" data-pre="$" data-post="bn+">$5bn+</p>
      <p class="sub">JP Morgan Chase</p>
    </article>

    <article class="tile map">
      <p class="big" data-count="66">66</p>
      <p class="cap">Cities in GTM rollout</p>
    </article>

    <article class="tile barsTile">
      <p class="cap">Anomalies found</p>
      <div class="bars" aria-hidden="true">
        {bars.map((h, i) => <span style={`--h:${h}%; --i:${i}`}></span>)}
      </div>
      <p class="sub">every quarter</p>
      <p class="big" data-count="1.5" data-post="k+">1.5k+</p>
      <ul class="chips"><li>JP Morgan</li><li>Risk</li><li>AI</li></ul>
    </article>

    <article class="tile wide">
      <p class="cap">Annual sales<br />opportunity identified</p>
      <p class="big" data-count="80" data-pre="₹" data-post="cr">₹80cr</p>
    </article>
  </div>
</section>

<style>
  .bento {
    position: relative;
    padding-block: 0 5rem;
    background: linear-gradient(#0c0c0d, #131315);
    font-family: var(--font-inter);
  }
  .grid {
    max-width: 90rem;
    display: grid;
    grid-template-columns: 1.15fr 1fr 1fr 1.15fr;
    grid-template-rows: 9.2rem 9.2rem;
    grid-template-areas: "g a m b" "g w w b";
    gap: 0.9rem;
  }
  .gauge { grid-area: g; }
  .a { grid-area: a; }
  .map { grid-area: m; }
  .barsTile { grid-area: b; }
  .wide { grid-area: w; }

  .tile {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.1rem 1.2rem;
    border-radius: 18px;
    background: linear-gradient(180deg, #111 0%, #0a0a0a 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
    text-align: center;
    transition: transform 0.45s var(--ease-reveal), border-color 0.45s, box-shadow 0.45s;
  }
  /* Hover: accent light rises from the bottom edge */
  .tile::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 70%;
    background: radial-gradient(60% 90% at 50% 100%, rgba(var(--acc-rgb), 0.35), transparent 70%);
    opacity: 0;
    transition: opacity 0.45s;
    pointer-events: none;
  }
  .tile:hover { transform: translateY(-3px); border-color: rgba(var(--acc-rgb), 0.5); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12), inset 0 -2px 0 var(--acc), 0 18px 40px rgba(var(--acc-rgb), 0.18); }
  .tile:hover::after { opacity: 1; }
  .tile > * { position: relative; z-index: 1; margin: 0; }

  .cap { color: #d9dce4; font-size: 0.95rem; line-height: 1.3; }
  .sub { color: #8a8f9c; font-size: 0.78rem; }
  .big { font-weight: 300; font-size: clamp(2.4rem, 3.6vw, 3.4rem); line-height: 1.05; letter-spacing: -0.03em; color: #f2f4f8; font-variant-numeric: tabular-nums; }
  .chips { list-style: none; display: flex; gap: 0.35rem; padding: 0; margin-top: 0.6rem; }
  .chips li { padding: 0.15rem 0.55rem; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.18); font-size: 0.66rem; color: #b8bcc8; }

  /* Gauge */
  .gauge svg { width: min(78%, 15rem); margin: 0.4rem 0 -0.4rem; }
  .gauge line { stroke: #2b2f3a; stroke-width: 6; stroke-linecap: round; }
  .gauge line.lit { stroke: var(--paper); opacity: 0.35; transition: opacity 0.3s calc(var(--i) * 35ms), stroke 0.3s; }
  .bento.seen .gauge line.lit { opacity: 1; }
  .gauge .needle { stroke: #cfd6e6; stroke-width: 3; transform-origin: 100px 104px; transform: rotate(-120deg); transition: transform 1.4s cubic-bezier(0.3, 1.4, 0.5, 1); }
  .bento.seen .gauge .needle { transform: rotate(62deg); }
  .gauge .hub { fill: #cfd6e6; }
  .gauge:hover line.lit { stroke: #fff; }

  /* Candle bars */
  .bars { display: flex; align-items: flex-end; gap: 5px; width: 78%; height: 5.4rem; margin: 0.4rem 0 0.3rem; }
  .bars span {
    flex: 1;
    height: var(--h);
    border-radius: 2px;
    background: linear-gradient(var(--paper), rgba(242, 241, 238, 0.25));
    transform: scaleY(0.15);
    transform-origin: bottom;
    transition: transform 0.7s var(--ease-reveal) calc(var(--i) * 45ms), filter 0.3s;
  }
  .bento.seen .bars span { transform: none; }
  .barsTile:hover .bars span { filter: brightness(1.35); }

  /* Dotted world map texture */
  .map {
    background:
      radial-gradient(circle, rgba(255, 255, 255, 0.16) 1px, transparent 1.5px) 0 0 / 9px 9px,
      linear-gradient(180deg, #111, #0a0a0a);
  }
  .map::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(70% 80% at 50% 45%, transparent 20%, #0b0b0b 75%);
  }

  .wide { flex-direction: row; justify-content: space-between; padding-inline: 2rem; text-align: left; }
  .wide .big { font-size: clamp(2.6rem, 4.4vw, 4rem); }

  @media (max-width: 1100px) {
    .grid { grid-template-columns: 1fr 1fr; grid-template-rows: auto; grid-template-areas: "g b" "a m" "w w"; }
    .tile { min-height: 9rem; }
  }
  @media (max-width: 600px) {
    .grid { grid-template-columns: 1fr; grid-template-areas: "g" "a" "m" "b" "w"; }
    .wide { flex-direction: column; text-align: center; gap: 0.4rem; }
  }
</style>

<script>
  const bento = document.querySelector<HTMLElement>('.bento')!;
  const nums = bento.querySelectorAll<HTMLElement>('[data-count]');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const countUp = (el: HTMLElement) => {
    const end = parseFloat(el.dataset.count!);
    const dec = el.dataset.count!.includes('.') ? 1 : 0;
    const pre = el.dataset.pre ?? '';
    const post = el.dataset.post ?? '';
    const t0 = performance.now();
    const tick = (t: number) => {
      const k = Math.min(1, (t - t0) / 1400);
      const v = end * (1 - Math.pow(1 - k, 3));
      el.textContent = pre + v.toFixed(dec) + post;
      if (k < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  new IntersectionObserver((entries, obs) => {
    if (!entries[0].isIntersecting) return;
    bento.classList.add('seen');
    if (!still) nums.forEach(countUp);
    obs.disconnect();
  }, { threshold: 0.35 }).observe(bento);
</script>
