---
import Stamp from './Stamp.astro';
import { sideProjects } from '../data/projects.js';
---
<section class="lab" id="lab">
  <div class="container">
    <div class="head">
      <div class="head-text">
        <h2 class="outline-title">the lab</h2>
      </div>
      <Stamp />
    </div>

    <ul class="rows">
      {sideProjects.map((p) => (
        <li>
          <details>
            <summary>
              <span class="title">{p.name}</span>
              <svg class="arrow" viewBox="0 0 24 24" width="34" height="34" aria-hidden="true">
                <path d="M7 17 17 7M7 7h10v10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <div class="body">
              <p class="eyebrow">{p.tag}</p>
              <p>{p.text}</p>
            </div>
          </details>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .lab {
    --stroke: rgba(0, 0, 0, 0.85);
    position: relative;
    background: linear-gradient(var(--c-lab-top), var(--c-lab));
    color: #000;
    padding-block: 5rem;
  }
  .head { display: flex; align-items: flex-start; justify-content: space-between; gap: 3.55556rem; margin-bottom: 3rem; }
  .head-text { display: flex; flex-direction: column; gap: 0.88889rem; }

  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(0, 0, 0, 0.35); }
  .rows li { border-bottom: 1px solid rgba(0, 0, 0, 0.35); }

  details { interpolate-size: allow-keywords; }
  details::details-content {
    block-size: 0;
    overflow: clip;
    transition: block-size 0.45s var(--ease-reveal), content-visibility 0.45s allow-discrete;
  }
  details[open]::details-content { block-size: auto; }

  summary {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 1.05rem;
    padding-right: 8px;
    list-style: none;
    cursor: pointer;
    transition: color 0.3s var(--ease-swift);
  }
  summary::-webkit-details-marker { display: none; }
  /* Black fill wipes up from the bottom on hover */
  summary::before {
    content: "";
    position: absolute;
    inset: 0;
    background: #000;
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.38s var(--ease-reveal);
  }
  .title { position: relative; font-weight: 600; font-size: clamp(1.35rem, 2.3vw, 1.9rem); line-height: 1.2; transition: transform 0.35s var(--ease-reveal); }
  .arrow { position: relative; flex: none; transition: transform 0.3s var(--ease-reveal); }
  details[open] .arrow { transform: rotate(90deg); }

  @media (hover: hover) {
    summary:hover { color: #d2d3d5; }
    summary:hover::before { transform: scaleY(1); transform-origin: bottom; }
    summary:hover .title { transform: translateX(40px); transition-delay: 0.08s; }
    summary:hover .arrow { transform: translateX(-40px); transition-delay: 0.08s; }
    details[open] summary:hover .arrow { transform: translateX(-40px) rotate(90deg); }
  }

  .body { max-width: 42rem; padding: 0.2rem 0 1.4rem; font-family: var(--font-inter); font-size: 1.11111rem; }
  .eyebrow { color: #666; }

  @media (prefers-reduced-motion: reduce) {
    summary, summary::before, .title, .arrow, details::details-content { transition: none; }
  }

  @media (max-width: 767.98px) {
    .lab { padding-block: 3.5rem 2.5rem; }
    .head { flex-direction: column; gap: 1rem; margin-bottom: 2rem; }
    .head :global(.stamp) { --k: 0.7 !important; }
    summary { padding-block: 0.9rem; }
    .arrow { width: 28px; height: 28px; }
  }
</style>
