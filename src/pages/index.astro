---
import Base from '../layouts/Base.astro';
import Work from '../components/Work.astro';
import Lab from '../components/Lab.astro';
import { url } from '../data/projects.js';

// Numbers from content/facts.md (resume). Wording is placeholder.
const proof = [
  { value: '~600', label: 'stores onboarded in 2 months' },
  { value: '$5bn+', label: 'portfolios monitored' },
  { value: '50+', label: 'frontline user interviews' },
];
---
<Base>
  <section class="hero container" aria-label="Introduction">
    <p class="eyebrow">ISB PGP YL '27 · IT and Operations</p>
    <h1>Radhika Goel</h1>
    <p class="lede">Placeholder positioning line: the kind of product manager I am and the problems I like to work on.</p>
    <ul class="proof">
      {proof.map((p) => <li><strong>{p.value}</strong><span>{p.label}</span></li>)}
    </ul>
    <div class="actions">
      <a class="btn" href={url('#work')}>View work</a>
      <a class="link" href={url('#contact')}>Get in touch</a>
    </div>
  </section>
  <Work />
  <Lab />
</Base>

<style>
  .hero { min-height: 100svh; display: flex; flex-direction: column; justify-content: center; padding-block: calc(var(--nav-h) + 2rem) 4rem; }
  h1 { margin: 0; font-weight: 600; font-size: clamp(3rem, 10vw, 8rem); line-height: 0.95; letter-spacing: -0.05em; }
  .lede { max-width: 38rem; margin: 1.5rem 0 0; color: var(--c-muted); font-size: clamp(1.11111rem, 2vw, 1.44444rem); }
  .proof { list-style: none; margin: 3rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 1.5rem 3.5rem; }
  .proof li { display: grid; }
  .proof strong { font-weight: 600; font-size: clamp(1.8rem, 3.4vw, 2.66667rem); line-height: 1.1; }
  .proof span { color: var(--c-muted); font-size: 0.94444rem; }
  .actions { display: flex; align-items: center; gap: 2rem; margin-top: 3rem; }
  .btn { padding: 0.8rem 1.6rem; border-radius: 999px; background: #fff; color: #000; font-weight: 600; transition: opacity 0.2s var(--ease-swift); }
  .btn:hover { opacity: 0.85; }
  .link { font-weight: 600; text-decoration: underline; text-underline-offset: 0.2em; }
  .link:hover { color: #bdbdbd; }
</style>
